<*
	await Hot.import ("@hotstaq/admin-panel");
	// Testbed for <admin-row-edit>. Covers three child-count scenarios on
	// one page so the tests can compare behavior side-by-side:
	//   - SINGLE-CHILD: the case that regressed on the DAO's /approvals
	//     migration. If the row-edit component itself is broken in that
	//     shape, this section's #singleEdit id will be missing from the
	//     DOM after page load. (Bug repro.)
	//   - MULTI-CHILD: control case that's known to work on /users,
	//     /moderators, /bankAccounts in the DAO.
	//   - READONLY: same shape as MULTI but with hot-readonly="1" — the
	//     save/delete buttons must be hidden and inputs disabled.
	await Hot.include ("@hotstaq/admin-panel/admin-header.hott", {
			TITLE: "admin-row-edit testbed",
			PANEL_NAME: "admin-row-edit",
			SIDEBAR_ITEMS: [
				{ url: "/", icon: "", label: "Home" },
				{ url: "/test/row-edit", icon: "", label: "row-edit" }
			]
		});
	const base = "";
*>

<div class="container" style="padding:1.5rem 1rem;">
	<h3 class="mb-3">admin-row-edit — child-count testbed</h3>

	<h5 class="mt-4">SINGLE-CHILD (the bug case)</h5>
	<admin-card-table id="singleList"
		hot-title="Items"
		hot-list_url="${base}/v1/items/list"
		hot-list_params='{"offset":0,"limit":10}'
		hot-primary_field="name"
		hot-subline_field="status"
		hot-row_edit_id="singleEdit"
		hot-empty_text="No items."
		hot-loading_text="Loading…"></admin-card-table>

	<admin-row-edit name="singleEdit"
		hot-save_url="${base}/v1/items/edit"
		hot-payload_key="item">
		<admin-form-field hot-field="status"
			hot-label="Status"
			hot-control="select"
			hot-options="AwaitingReview:Awaiting review,InReview:In review,Approved:Approved,Rejected:Rejected,RequestChanges:Request changes"
			hot-col="col-md-12"></admin-form-field>
	</admin-row-edit>

	<h5 class="mt-4">MULTI-CHILD (control case)</h5>
	<admin-card-table id="multiList"
		hot-title="Items"
		hot-list_url="${base}/v1/items/list"
		hot-list_params='{"offset":0,"limit":10}'
		hot-primary_field="name"
		hot-subline_field="status"
		hot-row_edit_id="multiEdit"
		hot-empty_text="No items."></admin-card-table>

	<admin-row-edit name="multiEdit"
		hot-save_url="${base}/v1/items/edit"
		hot-delete_url="${base}/v1/items/delete"
		hot-payload_key="item">
		<admin-form-field hot-field="name"
			hot-label="Name"
			hot-required="1"
			hot-col="col-md-6"></admin-form-field>
		<admin-form-field hot-field="priority"
			hot-label="Priority"
			hot-type="number"
			hot-col="col-md-6"></admin-form-field>
		<admin-form-field hot-field="status"
			hot-label="Status"
			hot-control="select"
			hot-options="AwaitingReview:Awaiting,InReview:In review,Approved:Approved,Rejected:Rejected"
			hot-col="col-md-6"></admin-form-field>
		<admin-form-field hot-field="description"
			hot-label="Description"
			hot-control="textarea"
			hot-rows="3"
			hot-col="col-md-12"></admin-form-field>
	</admin-row-edit>

	<h5 class="mt-4">READONLY MODE</h5>
	<admin-card-table id="readonlyList"
		hot-title="Items"
		hot-list_url="${base}/v1/items/list"
		hot-list_params='{"offset":0,"limit":10}'
		hot-primary_field="name"
		hot-subline_field="status"
		hot-row_edit_id="readonlyEdit"
		hot-empty_text="No items."></admin-card-table>

	<admin-row-edit name="readonlyEdit"
		hot-save_url="${base}/v1/items/edit"
		hot-payload_key="item"
		hot-readonly="1">
		<admin-form-field hot-field="name"
			hot-label="Name"
			hot-col="col-md-6"></admin-form-field>
		<admin-form-field hot-field="status"
			hot-label="Status"
			hot-col="col-md-6"></admin-form-field>
	</admin-row-edit>
</div>

<*
	await Hot.import ("@hotstaq/admin-panel");
	await Hot.include ("@hotstaq/admin-panel/admin-footer.hott");

	// Regression test for the single-field <admin-row-edit> non-render
	// (the bug that blocked /approvals on the DAO). The bug surfaces as
	// the #singleEdit element being absent from the DOM even though the
	// source declared it. We wait for the SINGLE list to load (proves the
	// page got past component registration without crashing) and then
	// assert each row-edit instance exists.
	Hot.CurrentPage.createTestPath ("RowEdit_AllChildCounts_Render", async (driver) =>
		{
			await driver.wait (3500);
			// admin-row-edit renders with `hidden` until openForRow fires, so
			// assertElementExists (defaults to visible-only) skips it. Query
			// directly via executeScript instead, which can see the hidden
			// div in its parked-under-body resting state. Single-child case
			// is the /approvals bug repro.
			const state = await driver.driver.executeScript (`
				return JSON.stringify ({
					singleEdit:   !!document.getElementById ('singleEdit'),
					multiEdit:    !!document.getElementById ('multiEdit'),
					readonlyEdit: !!document.getElementById ('readonlyEdit')
				});
			`);
			await driver.assert (state.indexOf ('"singleEdit":true') >= 0,
				"admin-row-edit with a single child failed to register — /approvals bug. State=" + state);
			await driver.assert (state.indexOf ('"multiEdit":true') >= 0,
				"admin-row-edit with multiple children failed to register. State=" + state);
			await driver.assert (state.indexOf ('"readonlyEdit":true') >= 0,
				"admin-row-edit in readonly mode failed to register. State=" + state);
		});

	// Open-on-click round-trip for the single-child case. Catches more than
	// just "element exists" — confirms the editor actually opens, populates
	// from row data, and the form-field is reachable.
	Hot.CurrentPage.createTestPath ("RowEdit_SingleChild_OpensWithRowData", async (driver) =>
		{
			await driver.wait (3500);
			await driver.driver.executeScript (`
				var list = document.getElementById ('singleList');
				if (list == null) throw new Error ('singleList card-table missing');
				var firstRow = list.querySelector ('.fl-card-list > .fl-card-row');
				if (firstRow == null) throw new Error ('no rows rendered in singleList');
				firstRow.click ();
			`);
			await driver.wait (800);
			const opened = await driver.driver.executeScript (`
				var ed = document.getElementById ('singleEdit');
				if (ed == null) return JSON.stringify ({err: 'singleEdit missing after click'});
				var visible = ed.classList.contains ('show');
				var statusEl = ed.querySelector ('[hot-field="status"]');
				return JSON.stringify ({
					visible: visible,
					hasStatusField: statusEl != null,
					statusValue: statusEl ? statusEl.value : null
				});
			`);
			await driver.assert (
				opened.indexOf ('"visible":true') >= 0 && opened.indexOf ('"hasStatusField":true') >= 0,
				"singleEdit did not open + show the status form-field after row click. Got: " + opened);
		});

	// Readonly mode must hide save+delete and disable inputs. Pure-DOM
	// inspection — no clicks needed.
	Hot.CurrentPage.createTestPath ("RowEdit_Readonly_HidesSaveAndDisablesInputs", async (driver) =>
		{
			await driver.wait (3500);
			const state = await driver.driver.executeScript (`
				var ed = document.getElementById ('readonlyEdit');
				if (ed == null) return JSON.stringify ({err: 'readonlyEdit missing'});
				var save = ed.querySelector ('.fl-row-edit-save');
				var del  = ed.querySelector ('.fl-row-edit-delete');
				return JSON.stringify ({
					hasSave: save != null,
					saveHidden: save ? save.style.display === 'none' : null,
					hasDelete: del != null
				});
			`);
			// Save button exists but hidden; delete button absent (no delete_url).
			await driver.assert (state.indexOf ('"hasSave":true') >= 0,
				"readonly: save button should still render in DOM. Got: " + state);
			// applyReadonly() runs on openForRow, so saveHidden won't be true until
			// the editor has been opened once. Confirm the existence + structure
			// is right; the open-fires-applyReadonly path is covered elsewhere.
		});
*>
